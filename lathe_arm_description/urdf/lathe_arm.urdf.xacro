<?xml version="1.0"?>
<!--
  5-DOF CNC Lathe Loading Arm — URDF

  ⚠️  PLACEHOLDER DIMENSIONS — Replace with Maharaj's real measurements.
  See docs/DESIGN.md "Dimensions needed" table.

  Kinematic chain (all revolute):
    world → base → link_1 (base_shoulder) → link_2 (upper_arm) →
    link_3 (forearm) → link_4 (wrist_pitch) → link_5 (wrist_roll) → ee

  Joint axes follow the URDF convention:
    joint_1: Z (base rotation / yaw)
    joint_2: Y (shoulder pitch)
    joint_3: Y (elbow pitch)
    joint_4: Y (wrist pitch)
    joint_5: X (wrist roll / gripper orientation)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="lathe_arm">

  <!-- ── PLACEHOLDER dimensions (metres) — REPLACE WITH REAL MEASUREMENTS ── -->
  <xacro:property name="L1" value="0.12"/>  <!-- base-to-shoulder height  -->
  <xacro:property name="L2" value="0.25"/>  <!-- upper arm length          -->
  <xacro:property name="L3" value="0.22"/>  <!-- forearm length            -->
  <xacro:property name="L4" value="0.10"/>  <!-- wrist pitch length        -->
  <xacro:property name="L5" value="0.06"/>  <!-- wrist roll / ee offset    -->
  <xacro:property name="link_r"  value="0.025"/> <!-- link cross-section radius -->
  <xacro:property name="base_r" value="0.06"/>   <!-- base cylinder radius -->

  <!-- ── Inertia helpers ─────────────────────────────────────────────────── -->
  <xacro:macro name="cyl_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0"
               iyy="${m*(3*r*r+h*h)/12}" iyz="0"
               izz="${m*r*r/2}"/>
    </inertial>
  </xacro:macro>

  <!-- ── World / base ─────────────────────────────────────────────────────── -->
  <link name="world"/>

  <joint name="world_fixed" type="fixed">
    <parent link="world"/>
    <child  link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><cylinder radius="${base_r}" length="0.05"/></geometry>
      <material name="dark_grey"><color rgba="0.25 0.25 0.25 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="${base_r}" length="0.05"/></geometry>
    </collision>
    <inertial><mass value="1.0"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/>
    </inertial>
  </link>

  <!-- ── Joint 1: base rotation (yaw) ─────────────────────────────────────── -->
  <joint name="joint_1_base_shoulder" type="revolute">
    <parent link="base_link"/>
    <child  link="link_1"/>
    <origin xyz="0 0 0.025" rpy="0 0 0"/>
    <axis   xyz="0 0 1"/>
    <limit  lower="-1.571" upper="1.571" effort="5.0" velocity="1.0"/>
    <dynamics damping="0.1"/>
  </joint>

  <link name="link_1">
    <visual>
      <origin xyz="0 0 ${L1/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${link_r}" length="${L1}"/></geometry>
      <material name="arm_blue"><color rgba="0.2 0.3 0.8 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 ${L1/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${link_r}" length="${L1}"/></geometry>
    </collision>
    <xacro:cyl_inertia m="0.4" r="${link_r}" h="${L1}"/>
  </link>

  <!-- ── Joint 2: shoulder pitch ───────────────────────────────────────────── -->
  <joint name="joint_2_shoulder_upper" type="revolute">
    <parent link="link_1"/>
    <child  link="link_2"/>
    <origin xyz="0 0 ${L1}" rpy="0 0 0"/>
    <axis   xyz="0 1 0"/>
    <limit  lower="-1.571" upper="1.571" effort="5.0" velocity="1.0"/>
    <dynamics damping="0.1"/>
  </joint>

  <link name="link_2">
    <visual>
      <origin xyz="${L2/2} 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="${link_r}" length="${L2}"/></geometry>
      <material name="arm_blue"><color rgba="0.2 0.3 0.8 1"/></material>
    </visual>
    <collision>
      <origin xyz="${L2/2} 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="${link_r}" length="${L2}"/></geometry>
    </collision>
    <xacro:cyl_inertia m="0.35" r="${link_r}" h="${L2}"/>
  </link>

  <!-- ── Joint 3: elbow pitch ──────────────────────────────────────────────── -->
  <joint name="joint_3_upper_elbow" type="revolute">
    <parent link="link_2"/>
    <child  link="link_3"/>
    <origin xyz="${L2} 0 0" rpy="0 0 0"/>
    <axis   xyz="0 1 0"/>
    <limit  lower="-2.094" upper="2.094" effort="5.0" velocity="1.0"/>
    <dynamics damping="0.1"/>
  </joint>

  <link name="link_3">
    <visual>
      <origin xyz="${L3/2} 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="${link_r * 0.85}" length="${L3}"/></geometry>
      <material name="arm_mid"><color rgba="0.3 0.5 0.8 1"/></material>
    </visual>
    <collision>
      <origin xyz="${L3/2} 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="${link_r * 0.85}" length="${L3}"/></geometry>
    </collision>
    <xacro:cyl_inertia m="0.30" r="${link_r}" h="${L3}"/>
  </link>

  <!-- ── Joint 4: wrist pitch ──────────────────────────────────────────────── -->
  <joint name="joint_4_elbow_wrist" type="revolute">
    <parent link="link_3"/>
    <child  link="link_4"/>
    <origin xyz="${L3} 0 0" rpy="0 0 0"/>
    <axis   xyz="0 1 0"/>
    <limit  lower="-1.571" upper="1.571" effort="3.0" velocity="1.5"/>
    <dynamics damping="0.05"/>
  </joint>

  <link name="link_4">
    <visual>
      <origin xyz="${L4/2} 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="${link_r * 0.7}" length="${L4}"/></geometry>
      <material name="arm_light"><color rgba="0.4 0.6 0.9 1"/></material>
    </visual>
    <collision>
      <origin xyz="${L4/2} 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="${link_r * 0.7}" length="${L4}"/></geometry>
    </collision>
    <xacro:cyl_inertia m="0.15" r="${link_r * 0.7}" h="${L4}"/>
  </link>

  <!-- ── Joint 5: wrist roll ───────────────────────────────────────────────── -->
  <joint name="joint_5_wrist_roll" type="revolute">
    <parent link="link_4"/>
    <child  link="link_5"/>
    <origin xyz="${L4} 0 0" rpy="0 0 0"/>
    <axis   xyz="1 0 0"/>
    <limit  lower="-3.14159" upper="3.14159" effort="2.0" velocity="2.0"/>
    <dynamics damping="0.02"/>
  </joint>

  <link name="link_5">
    <visual>
      <origin xyz="${L5/2} 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="${link_r * 0.6}" length="${L5}"/></geometry>
      <material name="ee_red"><color rgba="0.8 0.2 0.2 1"/></material>
    </visual>
    <collision>
      <origin xyz="${L5/2} 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="${link_r * 0.6}" length="${L5}"/></geometry>
    </collision>
    <xacro:cyl_inertia m="0.10" r="${link_r * 0.6}" h="${L5}"/>
  </link>

  <!-- ── End-effector ──────────────────────────────────────────────────────── -->
  <joint name="ee_fixed" type="fixed">
    <parent link="link_5"/>
    <child  link="end_effector"/>
    <origin xyz="${L5} 0 0" rpy="0 0 0"/>
  </joint>

  <link name="end_effector">
    <visual>
      <geometry><sphere radius="0.015"/></geometry>
      <material name="ee_marker"><color rgba="1 0.5 0 1"/></material>
    </visual>
  </link>

  <!-- ── Gazebo ros2_control plugin ────────────────────────────────────────── -->
  <ros2_control name="lathe_arm" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="joint_1_base_shoulder">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_2_shoulder_upper">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_3_upper_elbow">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_4_elbow_wrist">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_5_wrist_roll">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

</robot>
