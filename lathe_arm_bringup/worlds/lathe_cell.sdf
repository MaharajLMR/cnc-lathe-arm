<?xml version="1.0"?>
<!--
  Loading cell for the jib arm. Column axis at the origin, z up.

  A horizontal CNC lathe, which is what we loaded at the hackathon: the spindle
  lies flat and the billet goes into the chuck along that axis, not down onto it.
  A job tray next to the arm holds five billets lying radially in pockets.

  Every pose in here is printed by tools/make_waypoints.py from
  lathe_arm_teach/cell.py. Change the geometry there, run that, and copy the
  numbers across. tests/test_cell.py fails if the two drift apart.

    tray   origin 0.8615 -0.6032, yaw -0.6109, billet axes at z 0.8570
    lathe  origin 0.6342  0.9058, yaw -0.6109, spindle centreline at z 1.0260

  The lathe's own frame has +x running back along the spindle away from the
  chuck, and +y pointing away from the column, so the chuck sits at -x and the
  billet slides in that way.

  The billet is a real body. The gripper holds it with a detachable joint
  (part_grasp drives it), and the chuck takes it with a second one, because
  nothing here has jaws that really close.
-->
<sdf version="1.9">
  <world name="lathe_cell">
    <physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>

    <scene><ambient>0.5 0.5 0.5 1</ambient><background>0.8 0.82 0.85 1</background></scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -0.9</direction>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="col"><geometry><plane><normal>0 0 1</normal><size>12 12</size></plane></geometry></collision>
        <visual name="vis"><geometry><plane><normal>0 0 1</normal><size>12 12</size></plane></geometry>
          <material><ambient>0.5 0.52 0.5 1</ambient><diffuse>0.5 0.52 0.5 1</diffuse></material></visual>
        <!-- yellow safety line around the arm's swing -->
        <visual name="line"><pose>0 0 0.001 0 0 0</pose><geometry><cylinder><radius>1.6</radius><length>0.001</length></cylinder></geometry>
          <material><ambient>0.9 0.75 0.1 1</ambient><diffuse>0.9 0.75 0.1 1</diffuse></material></visual>
        <visual name="line_inner"><pose>0 0 0.0015 0 0 0</pose><geometry><cylinder><radius>1.55</radius><length>0.001</length></cylinder></geometry>
          <material><ambient>0.5 0.52 0.5 1</ambient><diffuse>0.5 0.52 0.5 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Job tray: five pockets 70 mm apart, billets lying radially. The arm
         picks the middle one; the other four are there so the tray looks like
         a tray. Pocket rails are 20 mm, billets are 50 mm, so they sit in. -->
    <model name="job_tray">
      <static>true</static>
      <pose>0.8615 -0.6032 0 0 0 -0.6109</pose>
      <link name="link">
        <visual name="foot"><pose>0 0 0.01 0 0 0</pose><geometry><box><size>0.40 0.50 0.02</size></box></geometry>
          <material><ambient>0.25 0.25 0.27 1</ambient><diffuse>0.25 0.25 0.27 1</diffuse></material></visual>
        <visual name="post"><pose>0 0 0.41 0 0 0</pose><geometry><box><size>0.12 0.12 0.80</size></box></geometry>
          <material><ambient>0.25 0.25 0.27 1</ambient><diffuse>0.25 0.25 0.27 1</diffuse></material></visual>
        <collision name="post"><pose>0 0 0.41 0 0 0</pose><geometry><box><size>0.12 0.12 0.80</size></box></geometry></collision>

        <!-- tray plate, top at 0.832 -->
        <visual name="plate"><pose>0 0 0.8195 0 0 0</pose><geometry><box><size>0.28 0.42 0.025</size></box></geometry>
          <material><ambient>0.2 0.35 0.6 1</ambient><diffuse>0.22 0.38 0.65 1</diffuse></material></visual>
        <collision name="plate"><pose>0 0 0.8195 0 0 0</pose><geometry><box><size>0.28 0.42 0.025</size></box></geometry></collision>

        <!-- rails between the pockets -->
        <visual name="rail_1"><pose>0 -0.175 0.842 0 0 0</pose><geometry><box><size>0.26 0.010 0.020</size></box></geometry>
          <material><ambient>0.15 0.25 0.45 1</ambient><diffuse>0.15 0.25 0.45 1</diffuse></material></visual>
        <visual name="rail_2"><pose>0 -0.105 0.842 0 0 0</pose><geometry><box><size>0.26 0.010 0.020</size></box></geometry>
          <material><ambient>0.15 0.25 0.45 1</ambient><diffuse>0.15 0.25 0.45 1</diffuse></material></visual>
        <visual name="rail_3"><pose>0 -0.035 0.842 0 0 0</pose><geometry><box><size>0.26 0.010 0.020</size></box></geometry>
          <material><ambient>0.15 0.25 0.45 1</ambient><diffuse>0.15 0.25 0.45 1</diffuse></material></visual>
        <visual name="rail_4"><pose>0 0.035 0.842 0 0 0</pose><geometry><box><size>0.26 0.010 0.020</size></box></geometry>
          <material><ambient>0.15 0.25 0.45 1</ambient><diffuse>0.15 0.25 0.45 1</diffuse></material></visual>
        <visual name="rail_5"><pose>0 0.105 0.842 0 0 0</pose><geometry><box><size>0.26 0.010 0.020</size></box></geometry>
          <material><ambient>0.15 0.25 0.45 1</ambient><diffuse>0.15 0.25 0.45 1</diffuse></material></visual>
        <visual name="rail_6"><pose>0 0.175 0.842 0 0 0</pose><geometry><box><size>0.26 0.010 0.020</size></box></geometry>
          <material><ambient>0.15 0.25 0.45 1</ambient><diffuse>0.15 0.25 0.45 1</diffuse></material></visual>
        <visual name="end_stop"><pose>-0.135 0 0.850 0 0 0</pose><geometry><box><size>0.012 0.40 0.036</size></box></geometry>
          <material><ambient>0.15 0.25 0.45 1</ambient><diffuse>0.15 0.25 0.45 1</diffuse></material></visual>

        <!-- the four billets the arm is not picking this cycle -->
        <visual name="billet_a"><pose>0 -0.14 0.857 0 1.5708 0</pose><geometry><cylinder><radius>0.025</radius><length>0.10</length></cylinder></geometry>
          <material><ambient>0.7 0.7 0.72 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse><specular>0.6 0.6 0.6 1</specular></material></visual>
        <visual name="billet_b"><pose>0 -0.07 0.857 0 1.5708 0</pose><geometry><cylinder><radius>0.025</radius><length>0.10</length></cylinder></geometry>
          <material><ambient>0.7 0.7 0.72 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse><specular>0.6 0.6 0.6 1</specular></material></visual>
        <visual name="billet_c"><pose>0 0.07 0.857 0 1.5708 0</pose><geometry><cylinder><radius>0.025</radius><length>0.10</length></cylinder></geometry>
          <material><ambient>0.7 0.7 0.72 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse><specular>0.6 0.6 0.6 1</specular></material></visual>
        <visual name="billet_d"><pose>0 0.14 0.857 0 1.5708 0</pose><geometry><cylinder><radius>0.025</radius><length>0.10</length></cylinder></geometry>
          <material><ambient>0.7 0.7 0.72 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse><specular>0.6 0.6 0.6 1</specular></material></visual>
      </link>
    </model>

    <!-- the billet this cycle loads: 50 mm bar, 100 mm long, lying radially -->
    <model name="part">
      <pose>0.8615 -0.6032 0.8570 0 1.5708 -0.6109</pose>
      <link name="link">
        <inertial><mass>0.3</mass><inertia><ixx>0.0003</ixx><iyy>0.0003</iyy><izz>0.0001</izz></inertia></inertial>
        <collision name="col"><geometry><cylinder><radius>0.025</radius><length>0.10</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.025</radius><length>0.10</length></cylinder></geometry>
          <material><ambient>0.7 0.7 0.72 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse><specular>0.6 0.6 0.6 1</specular></material></visual>
      </link>
    </model>

    <!-- Horizontal CNC lathe. Open on the top and on the arm's side so the
         gripper can come down between the chuck and the tailstock. A real one
         has a door and a roof hatch; this is the shape, not the machine. -->
    <model name="lathe">
      <static>true</static>
      <pose>0.6342 0.9058 0 0 0 -0.6109</pose>
      <link name="link">
        <visual name="cabinet"><pose>0.15 0.02 0.40 0 0 0</pose><geometry><box><size>1.34 0.88 0.80</size></box></geometry>
          <material><ambient>0.30 0.32 0.35 1</ambient><diffuse>0.33 0.35 0.38 1</diffuse></material></visual>
        <collision name="cabinet"><pose>0.15 0.02 0.40 0 0 0</pose><geometry><box><size>1.34 0.88 0.80</size></box></geometry></collision>

        <!-- slant bed behind the spindle line -->
        <visual name="bed"><pose>0.15 0.26 0.86 -0.35 0 0</pose><geometry><box><size>1.34 0.42 0.10</size></box></geometry>
          <material><ambient>0.46 0.48 0.51 1</ambient><diffuse>0.50 0.52 0.55 1</diffuse></material></visual>

        <!-- headstock, spindle centreline at z 1.026 -->
        <visual name="headstock"><pose>-0.325 0 1.03 0 0 0</pose><geometry><box><size>0.27 0.52 0.38</size></box></geometry>
          <material><ambient>0.46 0.48 0.51 1</ambient><diffuse>0.50 0.52 0.56 1</diffuse></material></visual>
        <visual name="spindle_nose"><pose>-0.21 0 1.026 0 1.5708 0</pose><geometry><cylinder><radius>0.075</radius><length>0.06</length></cylinder></geometry>
          <material><ambient>0.25 0.25 0.27 1</ambient><diffuse>0.25 0.25 0.27 1</diffuse></material></visual>

        <!-- turret on the far side, tool pointing at the spindle line -->
        <visual name="saddle"><pose>0.26 0.34 0.95 0 0 0</pose><geometry><box><size>0.30 0.26 0.30</size></box></geometry>
          <material><ambient>0.46 0.48 0.51 1</ambient><diffuse>0.50 0.52 0.55 1</diffuse></material></visual>
        <visual name="turret"><pose>0.20 0.26 1.12 0 0 0</pose><geometry><cylinder><radius>0.11</radius><length>0.14</length></cylinder></geometry>
          <material><ambient>0.25 0.27 0.30 1</ambient><diffuse>0.27 0.29 0.32 1</diffuse></material></visual>
        <visual name="tool"><pose>0.20 0.16 1.055 1.5708 0 0</pose><geometry><box><size>0.025 0.025 0.11</size></box></geometry>
          <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material></visual>

        <!-- tailstock -->
        <visual name="tailstock"><pose>0.67 0 1.00 0 0 0</pose><geometry><box><size>0.22 0.32 0.32</size></box></geometry>
          <material><ambient>0.46 0.48 0.51 1</ambient><diffuse>0.50 0.52 0.55 1</diffuse></material></visual>
        <visual name="quill"><pose>0.50 0 1.026 0 1.5708 0</pose><geometry><cylinder><radius>0.035</radius><length>0.14</length></cylinder></geometry>
          <material><ambient>0.6 0.6 0.62 1</ambient><diffuse>0.65 0.65 0.67 1</diffuse><specular>0.5 0.5 0.5 1</specular></material></visual>

        <!-- splash guards: back and both ends, top and arm side left open -->
        <visual name="guard_back"><pose>0.15 0.465 1.30 0 0 0</pose><geometry><box><size>1.42 0.03 1.00</size></box></geometry>
          <material><ambient>0.80 0.82 0.84 1</ambient><diffuse>0.84 0.86 0.88 1</diffuse></material></visual>
        <visual name="guard_left"><pose>-0.555 0.02 1.30 0 0 0</pose><geometry><box><size>0.03 0.88 1.00</size></box></geometry>
          <material><ambient>0.80 0.82 0.84 1</ambient><diffuse>0.84 0.86 0.88 1</diffuse></material></visual>
        <visual name="guard_right"><pose>0.855 0.02 1.30 0 0 0</pose><geometry><box><size>0.03 0.88 1.00</size></box></geometry>
          <material><ambient>0.80 0.82 0.84 1</ambient><diffuse>0.84 0.86 0.88 1</diffuse></material></visual>
        <visual name="stripe"><pose>0.15 -0.425 1.22 0 0 0</pose><geometry><box><size>1.34 0.02 0.05</size></box></geometry>
          <material><ambient>0.9 0.55 0.1 1</ambient><diffuse>0.95 0.6 0.1 1</diffuse></material></visual>

        <!-- operator panel on the right end -->
        <visual name="panel_arm"><pose>0.90 -0.20 1.25 0 0 0</pose><geometry><box><size>0.10 0.06 0.06</size></box></geometry>
          <material><ambient>0.25 0.25 0.27 1</ambient><diffuse>0.25 0.25 0.27 1</diffuse></material></visual>
        <visual name="panel"><pose>0.98 -0.20 1.36 0 -0.25 0</pose><geometry><box><size>0.06 0.34 0.42</size></box></geometry>
          <material><ambient>0.15 0.15 0.16 1</ambient><diffuse>0.15 0.15 0.16 1</diffuse></material></visual>
        <visual name="screen"><pose>0.95 -0.20 1.42 0 -0.25 0</pose><geometry><box><size>0.01 0.24 0.18</size></box></geometry>
          <material><ambient>0.1 0.35 0.25 1</ambient><diffuse>0.1 0.45 0.3 1</diffuse><emissive>0.05 0.2 0.15 1</emissive></material></visual>
      </link>
    </model>

    <!-- Chuck. Its own model, pinned to the world with a fixed joint rather
         than made static, because a detachable joint needs a real body to hang
         the billet off. Visual only: the billet passes through where the bore
         would be, and the second detachable joint is what actually holds it. -->
    <model name="chuck">
      <pose>0.6342 0.9058 0 0 0 -0.6109</pose>
      <link name="link">
        <inertial><mass>40.0</mass><inertia><ixx>1.0</ixx><iyy>1.0</iyy><izz>1.0</izz></inertia></inertial>
        <visual name="body"><pose>-0.100 0 1.026 0 1.5708 0</pose><geometry><cylinder><radius>0.105</radius><length>0.18</length></cylinder></geometry>
          <material><ambient>0.52 0.53 0.56 1</ambient><diffuse>0.60 0.61 0.64 1</diffuse><specular>0.7 0.7 0.7 1</specular></material></visual>
        <visual name="jaw_top"><pose>-0.030 0 1.088 0 0 0</pose><geometry><box><size>0.06 0.05 0.035</size></box></geometry>
          <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.14 0.14 0.14 1</diffuse></material></visual>
        <visual name="jaw_left"><pose>-0.030 -0.0537 0.995 1.0472 0 0</pose><geometry><box><size>0.06 0.05 0.035</size></box></geometry>
          <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.14 0.14 0.14 1</diffuse></material></visual>
        <visual name="jaw_right"><pose>-0.030 0.0537 0.995 -1.0472 0 0</pose><geometry><box><size>0.06 0.05 0.035</size></box></geometry>
          <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.14 0.14 0.14 1</diffuse></material></visual>
      </link>
      <joint name="anchor" type="fixed">
        <parent>world</parent>
        <child>link</child>
      </joint>
      <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
        <parent_link>link</parent_link>
        <child_model>part</child_model>
        <child_link>link</child_link>
        <attach_topic>/chuck/attach</attach_topic>
        <detach_topic>/chuck/detach</detach_topic>
        <suppress_child_warning>true</suppress_child_warning>
      </plugin>
    </model>

    <!-- Recording camera. It has to look into the open side of the machine,
         which faces the column, and square on to that puts the column right in
         front of the chuck. This is offset towards the tailstock end: far
         enough round to see past the column, near enough to see down the
         spindle, and it catches the tray as well. -->
    <model name="cell_camera">
      <static>true</static>
      <pose>0.002 -3.246 2.60 0 0.354 1.419</pose>
      <link name="link">
        <sensor name="cell_cam" type="camera">
          <update_rate>15</update_rate>
          <topic>/cell/image</topic>
          <camera>
            <horizontal_fov>0.95</horizontal_fov>
            <image><width>960</width><height>640</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>30</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- Close-up inside the guards, by the tailstock end, looking down the
         spindle at the chuck. The wide camera has to shoot past the column and
         ends up too far away to see the billet go in. -->
    <model name="chuck_camera">
      <static>true</static>
      <pose>1.158 0.172 1.35 0 0.314 2.223</pose>
      <link name="link">
        <sensor name="chuck_cam" type="camera">
          <update_rate>15</update_rate>
          <topic>/cell/closeup</topic>
          <camera>
            <horizontal_fov>0.8</horizontal_fov>
            <image><width>960</width><height>640</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>30</far></clip>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
