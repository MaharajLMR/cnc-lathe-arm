<?xml version="1.0"?>
<!--
  Loading cell for the jib arm (column axis at the origin).

  A raw part waits on a stand, the arm picks it from above and drops it into
  the chuck of a small vertical turning lathe. Positions come from the points
  in lathe_arm_teach/waypoints/example_load_cycle.yaml:
    at_part   gripper tips at r 1.044 m, yaw -35 deg, z 0.793
    at_chuck  gripper tips at r 1.070 m, yaw +55 deg, z 0.858

  The part is a real body. The arm attaches it when the gripper closes on it
  (DetachableJoint in the URDF, driven by part_grasp).
-->
<sdf version="1.9">
  <world name="lathe_cell">
    <physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>

    <scene><ambient>0.5 0.5 0.5 1</ambient><background>0.8 0.82 0.85 1</background></scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -0.9</direction>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="col"><geometry><plane><normal>0 0 1</normal><size>12 12</size></plane></geometry></collision>
        <visual name="vis"><geometry><plane><normal>0 0 1</normal><size>12 12</size></plane></geometry>
          <material><ambient>0.5 0.52 0.5 1</ambient><diffuse>0.5 0.52 0.5 1</diffuse></material></visual>
        <!-- yellow safety line around the arm's swing -->
        <visual name="line"><pose>0 0 0.001 0 0 0</pose><geometry><cylinder><radius>1.6</radius><length>0.001</length></cylinder></geometry>
          <material><ambient>0.9 0.75 0.1 1</ambient><diffuse>0.9 0.75 0.1 1</diffuse></material></visual>
        <visual name="line_inner"><pose>0 0 0.0015 0 0 0</pose><geometry><cylinder><radius>1.55</radius><length>0.001</length></cylinder></geometry>
          <material><ambient>0.5 0.52 0.5 1</ambient><diffuse>0.5 0.52 0.5 1</diffuse></material></visual>
      </link>
    </model>

    <!-- raw part stand, top at 0.783 m -->
    <model name="part_stand">
      <static>true</static>
      <pose>0.855 -0.599 0 0 0 -0.611</pose>
      <link name="link">
        <collision name="top"><pose>0 0 0.7615 0 0 0</pose><geometry><box><size>0.26 0.26 0.043</size></box></geometry></collision>
        <visual name="top"><pose>0 0 0.7615 0 0 0</pose><geometry><box><size>0.26 0.26 0.043</size></box></geometry>
          <material><ambient>0.2 0.35 0.6 1</ambient><diffuse>0.2 0.35 0.6 1</diffuse></material></visual>
        <visual name="leg"><pose>0 0 0.37 0 0 0</pose><geometry><box><size>0.08 0.08 0.74</size></box></geometry>
          <material><ambient>0.25 0.25 0.27 1</ambient><diffuse>0.25 0.25 0.27 1</diffuse></material></visual>
        <visual name="foot"><pose>0 0 0.01 0 0 0</pose><geometry><box><size>0.4 0.4 0.02</size></box></geometry>
          <material><ambient>0.25 0.25 0.27 1</ambient><diffuse>0.25 0.25 0.27 1</diffuse></material></visual>
      </link>
    </model>

    <!-- raw part: 50 mm bar, 100 mm long -->
    <model name="part">
      <pose>0.855 -0.599 0.834 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.3</mass><inertia><ixx>0.0003</ixx><iyy>0.0003</iyy><izz>0.0001</izz></inertia></inertial>
        <collision name="col"><geometry><cylinder><radius>0.025</radius><length>0.10</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.025</radius><length>0.10</length></cylinder></geometry>
          <material><ambient>0.7 0.7 0.72 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse><specular>0.6 0.6 0.6 1</specular></material></visual>
      </link>
    </model>

    <!-- vertical turning lathe, chuck facing up, chuck face at 0.848 m -->
    <model name="lathe">
      <static>true</static>
      <pose>0.614 0.877 0 0 0 0.960</pose>
      <link name="link">
        <collision name="chuck"><pose>0 0 0.808 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>0.08</length></cylinder></geometry></collision>
        <visual name="chuck"><pose>0 0 0.808 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.35 0.35 0.37 1</diffuse><specular>0.5 0.5 0.5 1</specular></material></visual>
        <visual name="jaw1"><pose>0.075 0 0.863 0 0 0</pose><geometry><box><size>0.04 0.025 0.03</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
        <visual name="jaw2"><pose>-0.0375 0.065 0.863 0 0 2.094</pose><geometry><box><size>0.04 0.025 0.03</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
        <visual name="jaw3"><pose>-0.0375 -0.065 0.863 0 0 -2.094</pose><geometry><box><size>0.04 0.025 0.03</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
        <visual name="table"><pose>0 0 0.74 0 0 0</pose><geometry><box><size>0.7 0.7 0.06</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.88 0.88 0.88 1</diffuse></material></visual>
        <visual name="cabinet"><pose>0 0 0.355 0 0 0</pose><geometry><box><size>0.75 0.75 0.71</size></box></geometry>
          <material><ambient>0.2 0.45 0.35 1</ambient><diffuse>0.2 0.45 0.35 1</diffuse></material></visual>
        <!-- column with the tool slide, on the far side from the arm -->
        <visual name="column"><pose>0.48 0 0.9 0 0 0</pose><geometry><box><size>0.22 0.6 1.8</size></box></geometry>
          <material><ambient>0.2 0.45 0.35 1</ambient><diffuse>0.2 0.45 0.35 1</diffuse></material></visual>
        <visual name="ram"><pose>0.29 0 1.15 0 0 0</pose><geometry><box><size>0.16 0.14 0.14</size></box></geometry>
          <material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.3 0.3 0.32 1</diffuse></material></visual>
        <visual name="tool"><pose>0.25 0 1.03 0 0 0</pose><geometry><box><size>0.04 0.04 0.12</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
        <visual name="panel"><pose>0.2 0.42 1.3 0 0 0</pose><geometry><box><size>0.2 0.04 0.3</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <!-- recording camera -->
    <model name="cell_camera">
      <static>true</static>
      <pose>4.0 -1.4 2.5 0 0.384 2.725</pose>
      <link name="link">
        <sensor name="cell_cam" type="camera">
          <update_rate>15</update_rate>
          <topic>/cell/image</topic>
          <camera>
            <horizontal_fov>0.9</horizontal_fov>
            <image><width>960</width><height>640</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>30</far></clip>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
