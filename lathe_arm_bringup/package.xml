<?xml version="1.0"?>
<package format="3">
  <name>lathe_arm_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and configuration for the 5-DOF lathe arm.</description>
  <maintainer email="lmrrajan2005@gmail.com">Maharaj L M R</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>lathe_arm_description</exec_depend>
  <exec_depend>lathe_arm_teach</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
