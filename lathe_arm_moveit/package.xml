<?xml version="1.0"?>
<package format="3">
  <name>lathe_arm_moveit</name>
  <version>0.1.0</version>
  <description>MoveIt 2 configuration for the 5-DOF CNC lathe loading arm.</description>
  <maintainer email="lmrrajan2005@gmail.com">Maharaj L M R</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>lathe_arm_description</exec_depend>
