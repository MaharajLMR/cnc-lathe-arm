<?xml version="1.0" ?>
<!--
  Semantic Robot Description Format (SRDF) for the 5-DOF CNC Lathe Arm.

  Defines:
    - Planning group "lathe_arm" (all 5 joints → KDL IK chain to ee_link)
    - End-effector "gripper" at ee_link
    - Named robot states
    - Disabled self-collision pairs
-->
<robot name="lathe_arm">

  <!-- ── Planning groups ─────────────────────────────────────────────────── -->
  <group name="lathe_arm">
    <chain base_link="base_link" tip_link="ee_link"/>
  </group>

  <!-- ── End-effector ────────────────────────────────────────────────────── -->
  <end_effector name="gripper"
                parent_link="ee_link"
                group="lathe_arm"/>

  <!-- ── Named states ────────────────────────────────────────────────────── -->

  <!-- All joints at zero — arm horizontal (safe retract for startup) -->
  <group_state name="home" group="lathe_arm">
    <joint name="joint_1_base_shoulder"  value="0"/>
    <joint name="joint_2_shoulder_upper" value="0"/>
    <joint name="joint_3_upper_elbow"    value="0"/>
    <joint name="joint_4_elbow_wrist"    value="0"/>
    <joint name="joint_5_wrist_roll"     value="0"/>
  </group_state>

  <!-- Arm angled down to part tray / conveyor for picking -->
  <group_state name="pre_pick" group="lathe_arm">
    <joint name="joint_1_base_shoulder"  value="-0.3"/>
    <joint name="joint_2_shoulder_upper" value="0.8"/>
    <joint name="joint_3_upper_elbow"    value="-1.5"/>
    <joint name="joint_4_elbow_wrist"    value="0.5"/>
    <joint name="joint_5_wrist_roll"     value="0"/>
  </group_state>

  <!-- Arm at part grasp height -->
  <group_state name="post_pick" group="lathe_arm">
    <joint name="joint_1_base_shoulder"  value="-0.3"/>
    <joint name="joint_2_shoulder_upper" value="0.5"/>
    <joint name="joint_3_upper_elbow"    value="-1.2"/>
    <joint name="joint_4_elbow_wrist"    value="0.4"/>
    <joint name="joint_5_wrist_roll"     value="0"/>
  </group_state>

  <!-- Arm extended toward lathe chuck -->
  <group_state name="drop" group="lathe_arm">
    <joint name="joint_1_base_shoulder"  value="0.8"/>
    <joint name="joint_2_shoulder_upper" value="0.6"/>
    <joint name="joint_3_upper_elbow"    value="-1.4"/>
    <joint name="joint_4_elbow_wrist"    value="0.3"/>
    <joint name="joint_5_wrist_roll"     value="0"/>
  </group_state>

  <!-- ── Disabled self-collision pairs ───────────────────────────────────── -->
  <disable_collisions link1="base_link"  link2="link_1" reason="Adjacent"/>
  <disable_collisions link1="link_1"     link2="link_2" reason="Adjacent"/>
  <disable_collisions link1="link_2"     link2="link_3" reason="Adjacent"/>
  <disable_collisions link1="link_3"     link2="link_4" reason="Adjacent"/>
  <disable_collisions link1="link_4"     link2="link_5" reason="Adjacent"/>
  <disable_collisions link1="link_5"     link2="ee_link" reason="Adjacent"/>

  <disable_collisions link1="base_link" link2="link_2" reason="Never"/>
  <disable_collisions link1="base_link" link2="link_3" reason="Never"/>
  <disable_collisions link1="link_1"    link2="link_3" reason="Never"/>
  <disable_collisions link1="link_1"    link2="link_4" reason="Never"/>
  <disable_collisions link1="link_2"    link2="link_4" reason="Never"/>
  <disable_collisions link1="link_2"    link2="link_5" reason="Never"/>
  <disable_collisions link1="link_3"    link2="link_5" reason="Never"/>
  <disable_collisions link1="link_3"    link2="ee_link" reason="Never"/>

</robot>
